# Compose interpolation only. No application/provider secrets here.
EDULABS_IMAGE=edulabs-web:COMMIT_SHA
EDULABS_WORKER_IMAGE=edulabs-worker:COMMIT_SHA
WEB_ENV_FILE=/etc/edulabs/web.env
CADDY_ENV_FILE=/etc/edulabs/caddy.env
FIREBASE_ADMIN_FILE=/etc/edulabs/firebase-admin.json
# Default is private loopback; use an SSH tunnel until DNS/TLS approval.
HTTPS_BIND=127.0.0.1
WORKER_ENV_FILE=/etc/edulabs/worker.env
NOTIFICATION_WORKER_KEY_FILE=/etc/edulabs/notification-worker.key
